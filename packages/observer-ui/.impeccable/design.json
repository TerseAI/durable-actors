    {
      "name": "Primary button",
      "kind": "button",
      "description": "Shared shadcn primary variant; outline and ghost are used by the observer.",
      "html": "<button class=\"ds-button ds-primary\" type=\"button\">Primary</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:8px 16px;border:0;border-radius:calc(var(--radius,8px) - 2px);font:500 14px/20px system-ui;cursor:pointer;transition:background-color 150ms ease-out,border-color 150ms ease-out,color 150ms ease-out,box-shadow 150ms ease-out,transform 150ms ease-out}.ds-button:focus-visible{outline:2px solid var(--ring,#737373);outline-offset:2px}.ds-button:active{transform:translateY(1px)}.ds-button:disabled{opacity:.45;pointer-events:none;transform:none}@media(max-width:767px){.ds-button{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-primary{background:var(--primary,#171717);color:var(--primary-foreground,#fff);box-shadow:var(--shadow-control,0 1px 2px rgb(0 0 0 / .04))}.ds-primary:hover{background:color-mix(in srgb,var(--primary,#171717) 88%,transparent)}",
      "refersTo": "button-primary"
    },
    {
      "name": "Outline button",
      "kind": "button",
      "description": "Shared shadcn outline variant; outline and ghost are used by the observer.",
      "html": "<button class=\"ds-button ds-outline\" type=\"button\">Refresh</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:8px 16px;border:0;border-radius:calc(var(--radius,8px) - 2px);font:500 14px/20px system-ui;cursor:pointer;transition:background-color 150ms ease-out,border-color 150ms ease-out,color 150ms ease-out,box-shadow 150ms ease-out,transform 150ms ease-out}.ds-button:focus-visible{outline:2px solid var(--ring,#737373);outline-offset:2px}.ds-button:active{transform:translateY(1px)}.ds-button:disabled{opacity:.45;pointer-events:none;transform:none}@media(max-width:767px){.ds-button{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-outline{border:1px solid var(--input,#dedede);background:var(--card,#fff);color:var(--foreground,#171717)}.ds-outline:hover{border-color:color-mix(in srgb,var(--foreground,#171717) 20%,transparent);background:var(--accent,#f0f0f0);color:var(--accent-foreground,#171717)}",
      "refersTo": "button-outline"
