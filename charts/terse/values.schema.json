{
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "repository",
        "digest"
      ]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "publicUrl": {
      "type": "string",
      "pattern": "^https://[^/?#@]+/?$"
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "storage": {
      "type": "object",
      "properties": {
        "authorityBucket": {
          "type": "string",
          "minLength": 3
        },
        "artifactBucket": {
          "type": "string",
          "minLength": 3
        },
        "archiveBucket": {
          "type": "string",
          "minLength": 3
        },
        "rapid": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "buckets"
          ],
          "properties": {
            "buckets": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "bucket",
                  "zone"
                ],
                "properties": {
                  "bucket": {
                    "type": "string",
                    "minLength": 3
                  },
                  "zone": {
                    "type": "string",
                    "pattern": "^[a-z]+-[a-z]+[0-9]+-[a-z]$"
                  }
                }
              }
            },
            "archiveBatchBytes": {
              "type": "integer",
              "minimum": 1
            },
            "archiveBatchIntervalMs": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "required": [
        "authorityBucket",
        "artifactBucket",
        "archiveBucket",
        "rapid"
      ],
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "googleServiceAccount": {
          "type": "string",
          "pattern": "^[^@]+@[^@]+[.]iam[.]gserviceaccount[.]com$"
        }
      },
      "required": [
        "googleServiceAccount"
      ]
    },
    "sockets": {
      "type": "object",
      "properties": {
        "maxConnectionsPerActor": {
          "type": "integer",
          "maximum": 32768,
          "minimum": 1
        },
        "dedicatedGateway": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 2
        },
        "nodeSelector": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        }
      },
      "required": [
        "maxConnectionsPerActor",
        "dedicatedGateway",
        "replicaCount"
      ]
    },
    "substrate": {
      "type": "object",
      "required": [
        "endpoint",
        "router",
        "atespace",
        "snapshotLocation",
        "worker",
        "egressCidrs"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^https://"
        },
        "snapshotLocation": {
          "type": "string",
          "pattern": "^gs://[^/]+/.*/$|^gs://[^/]+/$"
        },
        "atespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "worker": {
          "type": "object",
          "required": [
            "cpu",
            "memory",
            "image",
            "autoscaling"
          ],
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "minLength": 1
            },
            "image": {
              "type": "string",
              "pattern": "@sha256:[a-f0-9]{64}$"
            },
            "autoscaling": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minReplicas",
                "maxReplicas",
                "targetAllocationPercent",
                "scaleDownStabilizationSeconds"
              ],
              "properties": {
                "minReplicas": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxReplicas": {
                  "type": "integer",
                  "minimum": 1
                },
                "targetAllocationPercent": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 90
                },
                "scaleDownStabilizationSeconds": {
                  "type": "integer",
                  "minimum": 120,
                  "maximum": 3600
                }
              }
            }
          }
        },
        "egressCidrs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "location",
        "name"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      }
    }
  },
  "required": [
    "image",
    "replicaCount",
    "publicUrl",
    "region",
    "storage",
    "serviceAccount",
    "substrate"
  ],
  "$schema": "https://json-schema.org/draft-07/schema#"
}
