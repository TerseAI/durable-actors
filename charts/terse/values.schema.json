{
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "repository",
        "digest"
      ]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "publicUrl": {
      "type": "string",
      "pattern": "^https://[^/?#@]+/?$"
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "sandboxNamespace": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "zones": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z]+-[a-z]+[0-9]+-[a-z]$"
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "authorityBucket": {
          "type": "string",
          "minLength": 3
        },
        "artifactBucket": {
          "type": "string",
          "minLength": 3
        },
        "durability": {
          "enum": [
            "zonal",
            "regional",
            "multi_region"
          ]
        },
        "archiveBucket": {
          "type": "string",
          "minLength": 3
        },
        "replicas": {
          "type": "object",
          "properties": {
            "placements": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[a-z]+-[a-z]+[0-9]+-[a-z]$"
              }
            },
            "addresses": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^https?://[^/?#@]+/?$"
              }
            },
            "deployIndices": {
              "type": [
                "array",
                "null"
              ],
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "storageClassName": {
              "type": "string",
              "minLength": 1
            },
            "diskSize": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Gi|Ti)$"
            }
          },
          "required": [
            "placements",
            "storageClassName",
            "diskSize"
          ]
        }
      },
      "required": [
        "authorityBucket",
        "artifactBucket",
        "archiveBucket",
        "durability",
        "replicas"
      ]
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "googleServiceAccount": {
          "type": "string",
          "pattern": "^[^@]+@[^@]+[.]iam[.]gserviceaccount[.]com$"
        }
      },
      "required": [
        "googleServiceAccount"
      ]
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "const": true
        },
        "replicaCidrs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "enabled"
      ]
    }
  },
  "required": [
    "image",
    "replicaCount",
    "publicUrl",
    "region",
    "sandboxNamespace",
    "zones",
    "storage",
    "serviceAccount",
    "networkPolicy"
  ],
  "$schema": "https://json-schema.org/draft-07/schema#"
}
