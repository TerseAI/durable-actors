{
    "name": "little-actors",
    "version": "0.1.38",
    "description": "Provider-neutral actors for sandbox compute",
    "type": "module",
    "license": "MIT",
    "sideEffects": false,
    "engines": {
        "node": ">=20"
    },
    "packageManager": "pnpm@10.17.1",
    "keywords": [
        "actors",
        "distributed-systems",
        "durable-objects",
        "modal",
        "serverless"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TerseAI/little-actors.git",
        "directory": "sdk"
    },
    "homepage": "https://github.com/TerseAI/little-actors#readme",
    "bugs": {
        "url": "https://github.com/TerseAI/little-actors/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "little-actors": "dist/cli.js"
    },
    "exports": {
        "./dev": {
            "types": "./dist/localRuntime.d.ts",
            "import": "./dist/localRuntime.js"
        },
        "./proxy": {
            "types": "./dist/proxy.d.ts",
            "import": "./dist/proxy.js"
        },
        "./browser": {
            "types": "./dist/browser.d.ts",
            "import": "./dist/browser.js"
        },
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./host": {
            "types": "./dist/host.d.ts",
            "import": "./dist/host.js"
        },
        "./compiler": {
            "types": "./dist/compiler/actor-compiler.d.ts",
            "import": "./dist/compiler/actor-compiler.js"
        },
        "./codegen": {
            "types": "./dist/compiler/typescript-generator.d.ts",
            "import": "./dist/compiler/typescript-generator.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "scripts": {
        "build": "pnpm run generate:proto && tsc -p tsconfig.build.json && cp ../proto/durable_object.proto dist/generated/durable_object.proto && node scripts/build-template.mjs",
        "generate:proto": "proto-loader-gen-types --longs=Number --defaults --oneofs --grpcLib=@grpc/grpc-js --importFileExtension=.js --outDir=src/generated ../proto/durable_object.proto",
        "check": "pnpm run format:check && pnpm run test && pnpm run package:check",
        "clean": "rm -rf dist .test-dist",
        "package:check": "node scripts/check-package.mjs && node --test scripts/codegen-api.test.mjs",
        "prepack": "pnpm run clean && pnpm run build && pnpm run package:check",
        "test": "pnpm run clean && pnpm run build && node scripts/prepare-test-fixtures.mjs && tsc -p tsconfig.test.json && cp dist/generated/durable_object.proto .test-dist/src/generated/durable_object.proto && cd .test-dist && node --test --test-concurrency=1",
        "format": "prettier --config ../.prettierrc --write \"src/**/*.ts\" \"fixtures/**/*.ts\" \"scripts/*.mjs\"",
        "format:check": "prettier --config ../.prettierrc --check \"src/**/*.ts\" \"fixtures/**/*.ts\" \"scripts/*.mjs\""
    },
    "dependencies": {
        "@discoveryjs/json-ext": "^1.1.0",
        "@grpc/grpc-js": "^1.14.4",
        "@grpc/proto-loader": "^0.8.1",
        "@types/json-schema": "^7.0.15",
        "ajv": "^8.20.0",
        "commander": "^14.0.3",
        "json-schema-to-typescript": "^16.0.0",
        "tar": "^7.5.22",
        "tsx": "^4.0.0",
        "typescript": "~5.9.3",
        "typescript-json-schema": "^0.68.0",
        "ws": "^8.18.3",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/ws": "^8.18.1",
        "esbuild": "^0.28.2"
    }
}
