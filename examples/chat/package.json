{
    "name": "durable-actors-example-chat",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.19.0"
    },
    "scripts": {
        "dev": "durable-actors generate && tsx --env-file=.env src/backend.ts",
        "dev:actors": "durable-actors dev",
        "build": "durable-actors generate src/actors.ts && tsc --noEmit && vite build"
    },
    "dependencies": {
        "express": "^5.2.1",
        "durable-actors": "workspace:^",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.0",
        "@types/node": "^22.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "tsx": "^4.0.0",
        "typescript": "~5.9.3",
        "vite": "^8.3.0"
    }
}
