{
    "name": "durable-actors-example-sqlite",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.19.0"
    },
    "scripts": {
        "setup": "pnpm --dir ../../sdk build && cargo build --manifest-path ../../Cargo.toml --locked --bin durable-actors && durable-actors generate src/actors.ts",
        "dev": "durable-actors dev",
        "demo": "node --env-file=.env src/client.mjs demo",
        "notes": "node --env-file=.env src/client.mjs",
        "observe": "durable-actors observe",
        "check": "durable-actors generate src/actors.ts && tsc --noEmit",
        "test": "node --env-file=.env --test tests/*.test.mjs"
    },
    "dependencies": {
        "durable-actors": "workspace:^"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "~5.9.3"
    }
}
